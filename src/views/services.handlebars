<h1>Servicios disponibles</h1>

<div id="services-container">
  {{#if services.length}}
    {{#each services}}
      <article class="service-card" id="service-{{_id}}">
        <h2>{{name}}</h2>
        <p>{{description}}</p>
        <p>Duración: {{duration}} minutos</p>
        <p>Precio: ${{price}}</p>
        <p>Categoría: {{category}}</p>
        <p>Disponible: {{#if available}}Sí{{else}}No{{/if}}</p>
      </article>
    {{/each}}
  {{else}}
    <p>No services have been added.</p>
  {{/if}}
</div>
